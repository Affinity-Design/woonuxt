# Cloudflare Pages headers
#
# Do not override Content-Type or long-term caching for /_nuxt/* here.
# Cloudflare Pages assigns static-asset headers itself. More importantly, a
# missing hashed asset must keep its 404 status and HTML content type; labeling
# fallback HTML as immutable JavaScript can poison the CDN and browser cache.

# Security headers for all responses
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Nuxt payloads and build metadata must be revalidated so open tabs can detect
# a newly promoted deployment.
/_payload.json
  Cache-Control: no-cache, must-revalidate

/_nuxt/builds/latest.json
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate
